# ------------------------------------------------------------
# نمونه فایل تنظیمات محیطی
# این فایل را کپی کرده و با نام .env ذخیره کنید:  cp .env.example .env
#
# نکته: در هاست دایرکت‌ادمین به جای ساخت فایل .env می‌توانید همین مقدار را
# در بخش «Setup Node.js App» قسمت Environment variables وارد نمایید.
# ------------------------------------------------------------

# ---------- گزینه ۱: هاست دایرکت‌ادمین یا سی‌پنل (MySQL / MariaDB) ----------
# قالب: mysql://نام‌کاربری:رمزعبور@localhost:3306/نام‌دیتابیس
# توجه: در دایرکت‌ادمین معمولاً نام کاربر و دیتابیس با پیشوند نام اکانت ساخته می‌شوند.
DATABASE_URL=mysql://myuser_wallet:YOUR_PASSWORD@localhost:3306/myuser_wallet_db

# ---------- گزینه ۲: سرور شخصی یا VPS با PostgreSQL ----------
# DATABASE_URL=postgresql://wallet_user:YOUR_PASSWORD@127.0.0.1:5432/wallet_db

# ---------- گزینه ۳: دیتابیس ابری مانند Neon یا Supabase ----------
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/wallet_db?sslmode=require

# پورت اجرای برنامه (اختیاری - در دایرکت‌ادمین به صورت خودکار تعیین می‌شود)
# PORT=3000

# ---------- ثبت سریع از پیامک (شورتکات iOS) ----------
# توکن محافظ اندپوینت /api/sms-intake — این همان توکنی است که در شورتکات iOS وارد می‌کنید.
# اگر خالی بماند، اندپوینت بدون توکن کار می‌کند (مناسب تست).
# در محیط عملیاتی (production) حتماً یک رشته تصادفی طولانی قرار دهید،
# مثلاً خروجی دستور:  openssl rand -hex 24
SMS_INTAKE_TOKEN=
